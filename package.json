{
  "name": "pihka",
  "version": "0.1.0",
  "description": "Sustainable data publishing platform for digital humanities research",
  "type": "module",
  "scripts": {
    "dev": "browser-sync start --server pihka --files '**/*.js, **/*.css, **/*.html' --no-notify --no-ghost-mode",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "npx -y -p typescript tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-sample-db": "node scripts/create-sample-db.js",
    "prepare-sample-db": "node scripts/prepare-sample-db.js",
    "download-dbs": "node scripts/download-dbs.js",
    "download-world-pmtiles": "node scripts/download-world-pmtiles.js",
    "download-covers": "node scripts/download-covers.js",
    "download-full-text": "node scripts/download-full-text.js",
    "vendorize": "node scripts/vendorize-deps.js",
    "test:engine": "node --test tests/engine/*.test.js tests/architecture/*.test.js",
    "test:browser": "node scripts/test-browser-server.js",
    "test:scripts": "node --test tests/scripts/*.test.js",
    "vendorize:check": "node scripts/vendorize-deps.js --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.10",
    "browser-sync": "^3.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "preact": "^11.0.1"
  }
}
