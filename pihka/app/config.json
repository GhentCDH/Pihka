{
    "defaultLanguage": "en",
    "languages": [
        "en",
        "nl"
    ],
    "database": "app/database/sample.db",
    "databaseVersion": "2026.11.25",
    "site": {
        "title": {
            "en": "Explore literary authors and their works",
            "nl": "Verken literaire auteurs en hun werken"
        },
        "description": {
            "en": "<p>A demonstration deployment of <strong>Pihka</strong> by the Ghent Centre for Digital Humanities: a small, illustrative sample of literary authors and their works, to try out tables, curated views, maps, faceted filtering and full-text search.</p><p>Full texts come from <a href=\"https://www.gutenberg.org\" target=\"_blank\" rel=\"noopener noreferrer\">Project Gutenberg</a>. The data is for demonstration only; to publish your own dataset, see the <a href=\"#/en/page/instructions\">instructions</a>.</p>",
            "nl": "<p>Een demonstratie van <strong>Pihka</strong> door het Ghent Centre for Digital Humanities: een kleine, illustratieve steekproef van literaire auteurs en hun werken om tabellen, samengestelde weergaven, kaarten, facetfiltering en volledig-tekst zoeken uit te proberen.</p><p>De volledige teksten komen van <a href=\"https://www.gutenberg.org\" target=\"_blank\" rel=\"noopener noreferrer\">Project Gutenberg</a>. De data is enkel bedoeld als demonstratie; zie de <a href=\"#/nl/page/instructions\">handleiding</a> om je eigen dataset te publiceren.</p>"
        }
    },
    "perspectives": [
        {
            "id": "author-overview",
            "fts": true,
            "label": {
                "en": "Author bibliography",
                "nl": "Auteursbibliografie"
            },
            "table": "author_overview",
            "query": "SELECT a.id, a.name, a.birth_year, COUNT(w.id) AS work_count, GROUP_CONCAT(w.title, '|' ORDER BY w.year) AS works, MIN(w.year) AS first_year FROM authors a JOIN works w ON w.author_id = a.id GROUP BY a.id",
            "default_sort": "name"
        }
    ],
    "tables": {
        "works": {
            "label": {
                "en": "Works",
                "nl": "Boeken"
            },
            "columns": {
                "cover": {
                    "type": "resource-image",
                    "label": {
                        "en": "Cover",
                        "nl": "Omslag"
                    }
                },
                "year": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "Year",
                        "nl": "Jaar"
                    }
                },
                "manifest": {
                    "type": "iiif",
                    "label": {
                        "en": "IIIF",
                        "nl": "IIIF"
                    }
                },
                "full_text": {
                    "type": "text",
                    "maxWords": 30,
                    "fts": false,
                    "label": {
                        "en": "Full text",
                        "nl": "Volledige tekst"
                    }
                },
                "author_id": {
                    "label": {
                        "en": "Author",
                        "nl": "Auteur"
                    }
                }
            }
        },
        "categories": {
            "label": {
                "en": "Categories",
                "nl": "Categorieën"
            }
        },
        "works_categories": {
            "label": {
                "en": "Work categories",
                "nl": "Werkcategorieën"
            },
            "columns": {
                "work_id": {
                    "label": {
                        "en": "Work",
                        "nl": "Werk"
                    }
                },
                "category_id": {
                    "label": {
                        "en": "Category",
                        "nl": "Categorie"
                    }
                }
            }
        },
        "authors": {
            "label": {
                "en": "Authors",
                "nl": "Auteurs"
            }
        },
        "text_pages": {
            "label": {
                "en": "Text pages",
                "nl": "Tekstpagina's"
            },
            "columns": {
                "work_id": {
                    "label": {
                        "en": "Work",
                        "nl": "Werk"
                    }
                },
                "page_number": {
                    "type": "number",
                    "label": {
                        "en": "Page",
                        "nl": "Pagina"
                    }
                },
                "title": {
                    "label": {
                        "en": "Title",
                        "nl": "Titel"
                    }
                },
                "body": {
                    "type": "annotated-text",
                    "label": {
                        "en": "Text",
                        "nl": "Tekst"
                    }
                }
            }
        },
        "annotations": {
            "label": {
                "en": "Annotations",
                "nl": "Annotaties"
            },
            "columns": {
                "page_id": {
                    "label": {
                        "en": "Page",
                        "nl": "Pagina"
                    }
                },
                "start": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "Start",
                        "nl": "Begin"
                    }
                },
                "end": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "End",
                        "nl": "Einde"
                    }
                },
                "type": {
                    "label": {
                        "en": "Type",
                        "nl": "Type"
                    }
                },
                "label": {
                    "label": {
                        "en": "Label",
                        "nl": "Label"
                    }
                }
            }
        },
        "author_overview": {
            "label": {
                "en": "Author bibliography",
                "nl": "Auteursbibliografie"
            },
            "columns": {
                "id": {
                    "linkTo": "authors",
                    "label": "ID"
                },
                "name": {
                    "label": {
                        "en": "Name",
                        "nl": "Naam"
                    }
                },
                "birth_year": {
                    "label": {
                        "en": "Born",
                        "nl": "Geboren"
                    }
                },
                "work_count": {
                    "type": "number",
                    "label": {
                        "en": "Works",
                        "nl": "Aantal"
                    }
                },
                "works": {
                    "type": "list",
                    "separator": "|",
                    "label": {
                        "en": "Titles",
                        "nl": "Titels"
                    }
                },
                "first_year": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "First published",
                        "nl": "Eerste publicatie"
                    }
                }
            }
        }
    },
    "enginePlugins": [
        "extensions/geo-filter/geo-filter-engine.js"
    ],
    "uiPlugins": [
        "extensions/iiif-viewer/iiif-viewer-component.js",
        "extensions/point_map/point-map-component.js",
        "extensions/geo-filter/geo-filter-component.js",
        "extensions/text-annotations/text-annotations-component.js"
    ]
}
