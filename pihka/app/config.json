{
    "defaultLanguage": "en",
    "languages": [
        "en",
        "nl"
    ],
    "database": "app/database/sample.db",
    "components": [
        "extensions/iiif-viewer/iiif-viewer-component.js",
        "extensions/point_map/point-map-component.js",
        "extensions/geo-filter/geo-filter-component.js",
        "extensions/text-annotations/text-annotations-component.js"
    ],
    "perspectives": [
        {
            "id": "author-overview",
            "label": {
                "en": "Author overview",
                "nl": "Auteursoverzicht"
            },
            "table": "author_overview",
            "query": "SELECT a.id, a.name, a.birth_year, COUNT(w.id) AS work_count, GROUP_CONCAT(w.title, '|' ORDER BY w.year) AS works, MIN(w.year) AS first_year FROM authors a JOIN works w ON w.author_id = a.id GROUP BY a.id",
            "default_sort": "name"
        }
    ],
    "tables": {
        "works": {
            "label": {
                "en": "Works",
                "nl": "Boeken"
            },
            "columns": {
                "cover": {
                    "type": "asset",
                    "label": {
                        "en": "Cover",
                        "nl": "Omslag"
                    }
                },
                "year": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "Year",
                        "nl": "Jaar"
                    }
                },
                "manifest": {
                    "type": "iiif",
                    "label": {
                        "en": "IIIF",
                        "nl": "IIIF"
                    }
                },
                "full_text": {
                    "type": "text",
                    "fts": false,
                    "label": {
                        "en": "Full text",
                        "nl": "Volledige tekst"
                    }
                },
                "author_id": {
                    "label": {
                        "en": "Author",
                        "nl": "Auteur"
                    }
                }
            }
        },
        "categories": {
            "label": {
                "en": "Categories",
                "nl": "Categorieën"
            }
        },
        "works_categories": {
            "label": {
                "en": "Work categories",
                "nl": "Werkcategorieën"
            },
            "columns": {
                "work_id": {
                    "label": {
                        "en": "Work",
                        "nl": "Werk"
                    }
                },
                "category_id": {
                    "label": {
                        "en": "Category",
                        "nl": "Categorie"
                    }
                }
            }
        },
        "authors": {
            "label": {
                "en": "Authors",
                "nl": "Auteurs"
            }
        },
        "text_pages": {
            "label": {
                "en": "Text pages",
                "nl": "Tekstpagina's"
            },
            "columns": {
                "work_id": {
                    "label": {
                        "en": "Work",
                        "nl": "Werk"
                    }
                },
                "page_number": {
                    "type": "number",
                    "label": {
                        "en": "Page",
                        "nl": "Pagina"
                    }
                },
                "title": {
                    "label": {
                        "en": "Title",
                        "nl": "Titel"
                    }
                },
                "body": {
                    "type": "annotated-text",
                    "label": {
                        "en": "Text",
                        "nl": "Tekst"
                    }
                }
            }
        },
        "annotations": {
            "label": {
                "en": "Annotations",
                "nl": "Annotaties"
            },
            "columns": {
                "page_id": {
                    "label": {
                        "en": "Page",
                        "nl": "Pagina"
                    }
                },
                "start": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "Start",
                        "nl": "Begin"
                    }
                },
                "end": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "End",
                        "nl": "Einde"
                    }
                },
                "type": {
                    "label": {
                        "en": "Type",
                        "nl": "Type"
                    }
                },
                "label": {
                    "label": {
                        "en": "Label",
                        "nl": "Label"
                    }
                }
            }
        },
        "author_overview": {
            "label": {
                "en": "Author overview",
                "nl": "Auteursoverzicht"
            },
            "columns": {
                "id": {
                    "linkTo": "authors",
                    "label": "ID"
                },
                "name": {
                    "label": {
                        "en": "Name",
                        "nl": "Naam"
                    }
                },
                "birth_year": {
                    "label": {
                        "en": "Born",
                        "nl": "Geboren"
                    }
                },
                "work_count": {
                    "type": "number",
                    "label": {
                        "en": "Works",
                        "nl": "Aantal"
                    }
                },
                "works": {
                    "type": "list",
                    "separator": "|",
                    "label": {
                        "en": "Titles",
                        "nl": "Titels"
                    }
                },
                "first_year": {
                    "type": "number",
                    "format": {
                        "useGrouping": false
                    },
                    "label": {
                        "en": "First published",
                        "nl": "Eerste publicatie"
                    }
                }
            }
        }
    }
}