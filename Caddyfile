{
	admin off
	auto_https off
}

:3267 {
	root * .

	log {
		output stdout
		format filter {
			wrap json {
				time_key ""
				level_key ""
				name_key ""
				message_key ""
			}
			fields {
				request delete
				bytes_read delete
				user_id delete
				duration delete
				status delete
				resp_headers delete
				size rename bytes
			}
		}
	}
	log_append url {http.request.uri}
	log_append method {http.request.method}
	@range header Range *
	@full not header Range *
	log_append @range type range
	log_append @full type full

	# SQLite VFS offsets refer to the original file, never a compressed sidecar.
	@sqlite path *.db *.sqlite
	handle @sqlite {
		file_server
	}
	handle {
		file_server {
			precompressed
		}
	}

	# On-the-fly compression as a fallback for assets you didn't pre-compress
	# (HTML, JSON, JS, etc.). Skipped automatically for already-compressed
	# responses. Database content types are deliberately not included.
	encode {
		zstd
		gzip 5
		minimum_length 1024
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/wasm
			header Content-Type image/svg+xml
		}
	}

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		# Optional but often needed:
		Cross-Origin-Resource-Policy "same-origin"
	}

	# Long cache for the immutable DB artifacts (assuming you version the filename
	# or treat them as content-addressed). Adjust as needed.
	@db path *.db *.db.br *.db.gz *.sqlite *.sqlite.br *.sqlite.gz
	header @db Cache-Control "public, max-age=31536000, immutable"
	# The editable local demo keeps one URL; revalidate between sessions.
	header /pihka/app/database/sample.db Cache-Control "no-cache"
}
