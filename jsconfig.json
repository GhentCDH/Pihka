{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": ["pihka/core/js/**/*.js"],
    "exclude": ["node_modules", "pihka/core/vendor", "scripts"]
}
