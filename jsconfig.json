{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "checkJs": false,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": [
        "pihka/core/engine/**/*.js",
        "pihka/core/ui/**/*.js",
        "pihka/main.js",
        "pihka/bootstrap.js",
        "pihka/extensions/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "pihka/core/vendor",
        "pihka/extensions/*/vendor",
        "scripts"
    ]
}
